#!/usr/bin/env python3
"""Launch the immutable Control Freak release in current.json."""
from __future__ import annotations

import json
import os
import re
import sys

sys.dont_write_bytecode = True

APP_ROOT = "/userdata/roms/pygame/control-freak"
with open(os.path.join(APP_ROOT, "current.json"), encoding="utf-8") as handle:
    release_id = json.load(handle)["release_id"]
if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,79}", release_id):
    raise RuntimeError("Invalid Control Freak release pointer")
sys.path.insert(0, os.path.join(APP_ROOT, "releases", release_id))
os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
os.environ.setdefault("SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS", "0")

from control_freak.app import run  # noqa: E402


if __name__ == "__main__":
    run()
